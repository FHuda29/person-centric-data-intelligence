# Copy to .env and change every secret before any non-local use.
CONSOLE_PORT=8080

POSTGRES_USER=pcdi
POSTGRES_PASSWORD=pcdi-db-pass
POSTGRES_DB=pcdi
NEO4J_PASSWORD=pcdi-neo4j-pass
MINIO_ROOT_USER=pcdi
MINIO_ROOT_PASSWORD=pcdi-minio-secret
JWT_SECRET=change-me-in-production-please

# Bootstrap accounts (created only when the user table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin#12345
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=Analyst#12345

DEFAULT_PHONE_REGION=ID
# Auto-merge only for deterministic identifiers (shared phone/email) scoring >= 0.80. Name-only never merges.
AUTO_MERGE_DETERMINISTIC=false
WORKER_CONCURRENCY=4

# Self-hosted SearXNG metasearch (web, social search-index and news sweeps)
SEARXNG_SECRET=change-me-searxng-secret
# Google News locale for the news-portal connector
NEWS_REGION=id-ID
MASTODON_INSTANCE=mastodon.social

# Optional connector credentials — each source stays NEEDS_CREDENTIALS until its key is set
BRAVE_API_KEY=
# numverify / APILayer phone validation (numverify.com dashboard → "Your API Key")
NUMVERIFY_API_KEY=
# Free plan is http-only; paid plans may use https://apilayer.net/api/validate
NUMVERIFY_BASE_URL=http://apilayer.net/api/validate
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
# X API v2 (paid tier) bearer token
X_BEARER_TOKEN=
# Bluesky post search: account handle + app password (Settings → App passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# SandBase (sandbase.ai) licensed data API: public X posts/accounts and Instagram accounts. Paid per call; approve in Transform Hub.
SANDBASE_API_KEY=
# RedditAPIs (redditapis.com) third-party Reddit read API, paid per call; approve in Transform Hub.
REDDITAPIS_TOKEN=
